# ==============================================================================
# Face Identification & Blockchain Verification Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Face Detection & Matching Thresholds
# ------------------------------------------------------------------------------
# Confidence score threshold for YuNet face detection (0.0 to 1.0)
FACE_DETECTION_CONFIDENCE=0.8

# Cosine similarity threshold for SFace face matching (~0.363 is SFace standard)
MATCH_SIMILARITY_THRESHOLD=0.363

# Path to model storage directory
MODELS_DIR=data/models

# ------------------------------------------------------------------------------
# Search Provider Configuration
# ------------------------------------------------------------------------------
# Selected provider: 'serpapi_lens' (primary reverse image), 'duckduckgo', 'google_cse'
SEARCH_PROVIDER=serpapi_lens

# Maximum candidate results to discover and evaluate
MAX_CANDIDATES=10

# Primary: SerpApi API key for Google Lens Reverse Image Search
SERPAPI_API_KEY=your_serpapi_api_key_here

# Secondary / Fallback: Google Custom Search Engine (Optional)
GOOGLE_CSE_API_KEY=your_google_cse_api_key_here
GOOGLE_CSE_ENGINE_ID=your_google_cse_cx_id_here

# ------------------------------------------------------------------------------
# Blockchain Configuration (EVM / Web3.py)
# ------------------------------------------------------------------------------
# JSON-RPC endpoint (Anvil local default: http://127.0.0.1:8545 or Polygon Amoy / Sepolia RPC)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# EVM Private key for signing transactions (Anvil Account #0 default key for local dev)
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed VerificationRegistry Smart Contract Address
REGISTRY_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Blockchain mode: 'contract' or 'calldata'
BLOCKCHAIN_MODE=contract

# ------------------------------------------------------------------------------
# Logging & Storage Paths
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
CANDIDATES_CACHE_DIR=data/candidates
